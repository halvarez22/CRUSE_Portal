# ==============================================================================
# MICROFINANCIERA CRUSE FINTECH — PLANTILLA DE VARIABLES DE ENTORNO
# ==============================================================================
# Copiar como .env y sustituir cada <MARCADOR>. NUNCA comitear .env (Regla 5 SSD).
# El servidor NO arranca si falta o es inválida una variable obligatoria.
# Genere cada llave EN EL SERVIDOR DE DESTINO; jamás reutilice valores de otro entorno.
# ==============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Criptografía: KEK versionadas para Envelope Encryption (OBLIGATORIO) ---
# Cada CRUSE_KEK_V<n> debe ser base64 de EXACTAMENTE 32 bytes.
# Generar: openssl rand -base64 32
CRUSE_KEK_CURRENT_VERSION=1
CRUSE_KEK_V1=<GENERAR_CON_openssl_rand_-base64_32>
# Al rotar: agregar CRUSE_KEK_V2, cambiar CRUSE_KEK_CURRENT_VERSION=2 y conservar V1
# hasta re-envolver todas las DEK existentes.

# --- Criptografía: llave HMAC-SHA256 del Blind Index de CURP/RFC (OBLIGATORIO) ---
# base64, mínimo 32 bytes. Generar: openssl rand -base64 32
# ADVERTENCIA: cambiarla invalida todos los índices ciegos existentes.
BLIND_INDEX_SECRET=<GENERAR_CON_openssl_rand_-base64_32>

# --- Inteligencia Artificial (opcional; sin ella el chatbot opera en modo local) ---
GROQ_API_KEY=<TU_API_KEY_DE_GROQ>

# Twilio SMS 2FA (Requerido para producción)
TWILIO_ACCOUNT_SID=AC_tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VA_tu_verify_service_sid_aqui
TEST_PHONE_NUMBER=+520000000000
